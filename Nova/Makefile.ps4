# NOVA -> installable PS4 .pkg with the OpenOrbis PS4 toolchain (v0.5.x, LLVM 18 release).
# Modeled on the toolchain's own samples/SDL2/Makefile.  Needs only:
#   OO_PS4_TOOLCHAIN=<path to the extracted toolchain>   (SDL2 headers + libSDL2.a ship inside it)
#   clang, clang++, ld.lld (LLVM 18)
#
#   make -f Makefile.ps4 pkg      -> build/IV0000-PSMK00001_00-PS4MARKET0000001.pkg
TARGET      := ps4market
TITLE       := NOVA
VERSION     := 1.00
TITLE_ID    := PSMK00001
# 36 chars: IV0000-<TITLE_ID>_00-<16 chars>
CONTENT_ID  := IV0000-PSMK00001_00-PS4MARKET0000001

TC          := $(OO_PS4_TOOLCHAIN)
BIN         := $(TC)/bin/linux
PKGTOOL     := $(BIN)/PkgTool.Core
BUILD       := build
STAGE       := $(BUILD)/stage
CATALOG     := $(BUILD)/catalog.json
COVERS      := $(BUILD)/covers
SDL2_INC    ?= $(TC)/include/SDL2
SDL2_LIB    ?= $(TC)/lib
SRCS        := src/main.cpp src/platform_ps4.cpp src/http_download.cpp src/sha256.cpp src/catalog.cpp
OBJS        := $(SRCS:src/%.cpp=$(BUILD)/%.o)

# PkgTool.Core is a self-contained .NET binary; it aborts on machines without ICU unless this is set.
export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT := 1
# PkgTool.Core is built on .NET Core 3.0, which only understands OpenSSL 1.x. On a distro that ships only
# OpenSSL 3 (Ubuntu 22.04+, recent Fedora/Arch...) point SSL11_LIB at a directory holding libssl.so.1.1 and
# libcrypto.so.1.1 (build-pkg.sh and the CI workflow do this for you).
ifdef SSL11_LIB
export LD_LIBRARY_PATH := $(SSL11_LIB):$(LD_LIBRARY_PATH)
endif

# gnu++17, not c++17: strict -std=c++17 hides nanosleep() & friends in the toolchain's libc headers.
CXXFLAGS := --target=x86_64-pc-freebsd12-elf -fPIC -funwind-tables -std=gnu++17 -DPS4_NATIVE \
            -isysroot $(TC) -isystem $(TC)/include -isystem $(TC)/include/c++/v1 \
            -I$(SDL2_INC) -Isrc
LDFLAGS  := -m elf_x86_64 -pie --script $(TC)/link.x --eh-frame-hdr -L$(TC)/lib -L$(SDL2_LIB)
# Same system libs as the toolchain's SDL2 sample, plus -lSceNet for getaddrinfo().
LIBS     ?= -lc -lkernel -lc++ -lSceUserService -lSceVideoOut -lSceAudioOut -lScePad -lSceSysmodule -lSceFreeType -lSceNet -lSDL2

# Runtime modules + about file are taken from the toolchain's own SDL2 sample, as that sample does.
SAMPLE      := $(TC)/samples/SDL2
MODULES     := $(SAMPLE)/sce_module/libc.prx $(SAMPLE)/sce_module/libSceFios2.prx
RIGHT       := $(SAMPLE)/sce_sys/about/right.sprx

all: $(BUILD)/eboot.bin

$(BUILD)/%.o: src/%.cpp src/*.h
	@mkdir -p $(BUILD)
	clang++ $(CXXFLAGS) -c $< -o $@

$(BUILD)/$(TARGET).elf: $(OBJS)
	ld.lld $(LDFLAGS) $(TC)/lib/crt1.o $(OBJS) $(LIBS) -o $@

$(BUILD)/eboot.bin: $(BUILD)/$(TARGET).elf
	$(BIN)/create-fself -in=$< -out=$(BUILD)/$(TARGET).oelf --eboot=$@ --paid 0x3800000000000011

$(BUILD)/param.sfo: Makefile.ps4
	@mkdir -p $(BUILD)
	rm -f $@
	$(PKGTOOL) sfo_new $@
	$(PKGTOOL) sfo_setentry $@ APP_TYPE           --type Integer --maxsize 4   --value 1
	$(PKGTOOL) sfo_setentry $@ APP_VER            --type Utf8    --maxsize 8   --value '$(VERSION)'
	$(PKGTOOL) sfo_setentry $@ ATTRIBUTE          --type Integer --maxsize 4   --value 0
	$(PKGTOOL) sfo_setentry $@ CATEGORY           --type Utf8    --maxsize 4   --value 'gd'
	$(PKGTOOL) sfo_setentry $@ CONTENT_ID         --type Utf8    --maxsize 48  --value '$(CONTENT_ID)'
	$(PKGTOOL) sfo_setentry $@ DOWNLOAD_DATA_SIZE --type Integer --maxsize 4   --value 0
	$(PKGTOOL) sfo_setentry $@ SYSTEM_VER         --type Integer --maxsize 4   --value 0
	$(PKGTOOL) sfo_setentry $@ TITLE              --type Utf8    --maxsize 128 --value '$(TITLE)'
	$(PKGTOOL) sfo_setentry $@ TITLE_ID           --type Utf8    --maxsize 12  --value '$(TITLE_ID)'
	$(PKGTOOL) sfo_setentry $@ VERSION            --type Utf8    --maxsize 8   --value '$(VERSION)'

# Stage eboot + sce_sys + sce_module next to the gp4, then build the package.
refresh-catalog:
	@mkdir -p $(BUILD)
	python3 tools/sync_nova_catalog.py --out $(CATALOG)

refresh-covers: refresh-catalog
	python3 tools/fetch_nova_covers.py --catalog $(CATALOG) --out $(COVERS)

pkg: $(BUILD)/eboot.bin $(BUILD)/param.sfo refresh-covers
	rm -rf $(STAGE) && mkdir -p $(STAGE)/sce_sys/about $(STAGE)/sce_module $(STAGE)/sce_sys/covers
	cp $(BUILD)/eboot.bin $(STAGE)/
	cp $(BUILD)/param.sfo pkg/sce_sys/icon0.png $(STAGE)/sce_sys/
	cp $(CATALOG) $(STAGE)/sce_sys/catalog.json
	if [ -d $(COVERS) ]; then cp -R $(COVERS)/. $(STAGE)/sce_sys/covers/; fi
	cp $(RIGHT) $(STAGE)/sce_sys/about/
	cp $(MODULES) $(STAGE)/sce_module/
	cd $(STAGE) && $(BIN)/create-gp4 -out pkg.gp4 --content-id=$(CONTENT_ID) --files "$$(find . -type f | sed 's|^\./||' | sort | tr '\n' ' ')"
	cd $(STAGE) && $(PKGTOOL) pkg_build pkg.gp4 ..
	@ls -l $(BUILD)/*.pkg

clean:
	rm -rf $(BUILD)
.PHONY: all pkg clean refresh-catalog refresh-covers
